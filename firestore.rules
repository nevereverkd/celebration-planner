rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The client stores each account's complete planner state in one document.
    // Keep this document private to the authenticated owner and bound its list size.
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validCelebrations(data) {
      return data.keys().hasAll(['events', 'updatedAt', 'clientTimestamp'])
        && data.keys().hasOnly(['events', 'updatedAt', 'clientTimestamp'])
        && data.events is list
        && data.events.size() <= 100
        && data.updatedAt is timestamp
        && data.clientTimestamp is string
        && data.clientTimestamp.size() <= 40;
    }

    match /user_celebrations/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId) && validCelebrations(request.resource.data);
      allow update: if owns(userId) && validCelebrations(request.resource.data);
      allow delete: if owns(userId);
    }

    // Deny every collection not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
